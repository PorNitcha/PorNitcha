      <td class="num">689</td><td class="num">22.37</td><td class="num">&mdash;</td><td class="num">&mdash;</td>
      <td><span class="badge wait">รอผลโม่</span><span class="status-detail">%Recovery 100.0% = default &rarr; ยังไม่มีผลโม่ 30-Sep &middot; CBG 3.91&divide;22.37% = 17.48 ✓</span></td>
