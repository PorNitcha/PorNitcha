    recov:  [94.6, 100.6, 99.1, 95.6, 96, 96.4, 98.1, 95.2, 93.6, 98.7, 100.4, 100.5, 97.6, 92.6, 95.7, 94.4, 101, 100.5, 97.3, 99.2, 99.6, null, 94.3, 98.3, 96.7, null, null, null, null, null]
  },
  MS: { label: "MS", fullName: "แม่สอด ตาก",
    price:  [null, null, null, 3.75, 3.78, 3.71, 3.79, 3.79, 3.84, 3.81, 3.79, 3.81, 3.83, 3.82, 3.82, 3.9, 3.98, 3.99, 3.93, 4.01, 4.02, 3.92, 4.11, 3.98, 4.13, 4.07, 4.21, 4.03, 4.1, 3.9],
    volume: [0, 0, 0, 29, 188, 101, 154, 187, 170, 194, 242, 289, 298, 238, 205, 332, 376, 290, 423, 404, 360, 461, 254, 241, 295, 522, 517, 438, 294, 206],
    starch: [null, null, null, 20.69, 20.61, 20.15, 21.28, 20.88, 22.22, 21.8, 21.54, 21.73, 23.29, 22.48, 24.16, 23.36, 24.56, 25.7, 23.67, 23.84, 24.24, 22.29, 25.92, 24.59, 26.48, 25.54, 26.01, 23.79, 25.15, 21.98],
    cag:    [null, null, null, null, null, null, 21.52, 19.34, 18.51, null, null, 21.41, 15.86, null, null, 18.4, 38.53, null, 21.28, 18.64, 15.9, 19.08, null, null, 18.5, 17.69, 16.72, null, null, null],
    recov:  [null, null, null, null, null, null, 82.8, 93.9, 93.4, null, null, 81.9, 103.7, null, null, 90.8, 42.1, null, 78, 90.2, 104.3, 92.2, null, null, 84.3, 90.1, 96.8, null, null, null]
  },
