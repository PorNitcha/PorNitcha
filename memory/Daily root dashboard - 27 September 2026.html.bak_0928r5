    volume: [298, 355, 210, 268, 399, 458, 328, 501, 282, 421, 279, 244, 192, 133, 282, null, 325, 222, 388, 490, 511, 497, 460, 304, 357, 360, null, 391, 112, null],
    starch: [19.56, 19.67, 21.88, 19.81, 20.52, 21.05, 20.16, 20.84, 20.55, 20.54, 21.02, 19.58, 20.42, 19.39, 21.24, null, 20.28, 21.45, 19.8, 19.86, 20.36, 20.45, 21.12, 20.2, 20.61, 20.2, null, 21.43, 18.98, null],
