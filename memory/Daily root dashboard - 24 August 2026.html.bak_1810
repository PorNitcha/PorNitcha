    volume: [0, 216, 193, 125, 73, 86, 87, 0, 297, 239, 467, 518, 544, 510, 595, 591, 549, 463, 215, 318, 420, 244, 373, 453, 492, 542, 534, 481, 560, 576],
    starch: [null, 16.54, 16.24, 16.64, 16.87, 17.15, 17.29, null, 16.55, 17.13, 18.32, 17.16, 16.35, 17.3, 17.3, 16.84, 17.11, 17.31, 18.36, 17.3, 17.68, 17.37, 17.18, 18.06, 18.17, 18.59, 18.57, 18.95, 18.36, 18.3],
