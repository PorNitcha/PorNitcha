  ที่มา (external): nettathai.org ·
  หน้านี้อัปเดตอัตโนมัติเมื่อพบข้อมูลวันใหม่ในไฟล์ต้นทาง
</div>

<script>
const dates = ["26-Jul", "27-Jul", "28-Jul", "29-Jul", "30-Jul", "31-Jul", "1-Aug", "2-Aug", "3-Aug", "4-Aug", "5-Aug", "6-Aug", "7-Aug", "8-Aug", "9-Aug", "10-Aug", "11-Aug", "12-Aug", "13-Aug", "14-Aug", "15-Aug", "16-Aug", "17-Aug", "18-Aug", "19-Aug", "20-Aug", "21-Aug", "22-Aug", "23-Aug", "24-Aug"];

// null = ไม่มีค่าที่มีความหมาย · volume คง 0 · TWIC แยกจากยอดไทย
const plants = {
  TN: { label: "TN", fullName: "อ.เมือง อุดรธานี",
