  },
  MS: { label: "MS", fullName: "แม่สอด ตาก",
    price:  [null, null, null, null, null, null, null, null, 3.75, 3.78, 3.71, 3.79, 3.79, 3.84, 3.81, 3.79, 3.81, 3.83, 3.82, 3.82, 3.9, 3.98, 3.99, 3.93, 4.01, 4.02, 3.92, 4.11, 3.98, 4.13],
    volume: [0, 0, 0, 0, 0, 0, 0, 0, 29, 188, 101, 154, 187, 170, 194, 242, 289, 298, 238, 205, 332, 376, 290, 423, 404, 360, 461, 254, 241, 295],
    starch: [null, null, null, null, null, null, null, null, 20.69, 20.61, 20.15, 21.28, 20.88, 22.22, 21.8, 21.54, 21.73, 23.29, 22.48, 24.16, 23.36, 24.56, 25.7, 23.67, 23.84, 24.24, 22.29, 25.92, 24.59, 26.48],
    cag:    [null, null, null, null, null, null, null, null, null, null, null, 21.52, 19.34, 18.51, null, null, 21.41, 15.86, null, null, 18.4, 38.53, null, 21.28, 18.64, 15.9, 19.08, null, null, 18.5],
    recov:  [null, null, null, null, null, null, null, null, null, null, null, 82.8, 93.9, 93.4, null, null, 81.9, 103.7, null, null, 90.8, 42.1, null, 78, 90.2, 104.3, 92.2, null, null, 84.3]
  },
  TWIC: { label: "TWIC", fullName: "TWIC กัมพูชา (Oddar Meanchey)",
    price:  [3.19, 3.17, 3.31, 3.23, 3.24, 3.14, 3.19, 3.47, 3.32, 3.33, 3.45, 3.35, 3.31, 3.38, 3.34, 3.3, 3.27, 3.31, 3.21, 3.37, null, 3.29, 3.34, 3.36, 3.36, 3.38, 3.34, 3.27, 3.03, null],
    volume: [576, 622, 544, 395, 543, 298, 355, 210, 268, 399, 458, 328, 501, 282, 421, 279, 244, 192, 133, 282, null, 325, 222, 388, 490, 511, 497, 460, 304, null],
    starch: [18.3, 18.09, 18.4, 18.05, 18.61, 19.56, 19.67, 21.88, 19.81, 20.52, 21.05, 20.16, 20.84, 20.55, 20.54, 21.02, 19.58, 20.42, 19.39, 21.24, null, 20.28, 21.45, 19.8, 19.86, 20.36, 20.45, 21.12, 20.2, null],
